{
  "name": "aray-android",
  "version": "4.6.4",
  "description": "ARAY — Android Photo Booth App",
  "main": "index.js",
  "scripts": {
    "build:web": "vite build --config vite.android.config.ts",
    "sync": "cap sync android",
    "build:android": "npm run build:web && npm run sync && cd android && ./gradlew assembleDebug",
    "build:release": "npm run build:web && npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor-community/sqlite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "framer-motion": "^11.3.21",
    "lucide-react": "^0.428.0",
    "zustand": "^4.5.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41"
  }
}
